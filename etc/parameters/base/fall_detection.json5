{
  // Angles in radians, velocities in radians per second, lengths in metres.
  maximum_observation_age: { secs: 0, nanos: 50000000 },
  detection_lifetime: { secs: 0, nanos: 100000000 },
  upright: {
    maximum_torso_tilt: 0.349066,
    // Allow the measured terminal get-up oscillation without accepting fast swings.
    maximum_torso_angular_velocity: 2.5,
    maximum_leg_joint_velocity: 6.0,
    minimum_torso_height_above_soles: 0.43,
    // Confirms entry into Upright.
    confirmation_duration: { secs: 0, nanos: 100000000 },
  },
  falling: {
    // 40 degrees, with 20 degrees of hysteresis from Upright.
    minimum_torso_tilt: 0.698132,
    // Confirms Upright -> Falling; standup timeout bypasses this delay.
    confirmation_duration: { secs: 0, nanos: 20000000 },
  },
  fallen: {
    minimum_torso_tilt: 1.047198,
    // Wait for body rotation and distributed limb motion to settle before Prepare.
    maximum_torso_angular_velocity: 0.5,
    maximum_joint_velocity: 1.0,
    maximum_joint_velocity_sum: 3.0,
    // Confirms entry into Fallen; allow Booster's roughly 0.67 s quiet startup pause.
    confirmation_duration: { secs: 0, nanos: 700000000 },
  },
  standing_up: {
    // Nominal Prepare pose, rounded from robot 43's serial joint feedback.
    start_pose: {
      left_arm: { shoulder_pitch: 0.2, shoulder_roll: -1.45, shoulder_yaw: 0.0, elbow: -0.5 },
      right_arm: { shoulder_pitch: 0.2, shoulder_roll: 1.45, shoulder_yaw: 0.0, elbow: 0.5 },
      left_leg: { hip_pitch: 0.0, hip_roll: 0.0, hip_yaw: 0.0, knee: 0.1, ankle_up: -0.1, ankle_down: 0.0 },
      right_leg: { hip_pitch: 0.0, hip_roll: 0.0, hip_yaw: 0.0, knee: 0.1, ankle_up: -0.1, ankle_down: 0.0 },
    },
    // Require the torso within 20 degrees of flat on the front or back, with little rotation.
    maximum_start_pose_torso_deviation: 0.349066,
    maximum_start_pose_torso_angular_velocity: 0.25,
    maximum_start_pose_joint_position_deviation: 0.5,
    maximum_start_pose_joint_velocity: 1.0,
    maximum_start_pose_joint_velocity_sum: 2.5,
    // Confirms ready_for_standup while the posture is still Fallen.
    confirmation_duration: { secs: 0, nanos: 200000000 },
    // Rearms the fallen guard after its conditions stop holding for this duration.
    movement_confirmation_duration: { secs: 0, nanos: 50000000 },
    // Booster is still recovering at 4 s. Retain the longer bounded attempt window.
    timeout: { secs: 8, nanos: 0 },
  },
}
