{
  neural_networks_folder: "etc/neural_networks",
  inference_threads: 1,
  timing: {
    policy_period: { secs: 0, nanos: 20000000 },
    sensor_period: { secs: 0, nanos: 2000000 },
    arm_blend_duration: { secs: 1, nanos: 0 },
  },
  // Velocity limiter delta is degrees/second per sensor update; scales encode network features.
  observation: {
    quaternion_norm_tolerance: 0.05,
    maximum_velocity_sample_gap_frames: 2.5,
    maximum_walking_velocity_change_degrees: 100.0,
    joint_velocity_scale: 0.1,
  },
  // Linear velocities: m/s; angular limit: rad/s.
  // Frequencies: Hz; distances: metres; arm angles: degrees.
  // Shoulder position scales: rad/m; elbow_scale is dimensionless.
  locomotion: {
    forward_velocity_limits: [-1.0, 2.0],
    lateral_velocity_limit: 1.0,
    angular_velocity_limit: 1.5,
    base_frequency: 1.5,
    // The startup observation intentionally exceeds the subsequent correction limit.
    initial_frequency_offset: 1.5,
    frequency_offset_limit: 0.5,
    shoulder_pitch_scale: 1.5,
    shoulder_roll_degrees: -78.0,
    shoulder_roll_scale: 2.5,
    knee_lateral_offset: 0.096,
    elbow_degrees: -30.0,
    elbow_scale: 1.3,
  },
  // Speeds: m/s; distances: metres; direction ramps: degrees.
  kick: {
    speed_limits: [0.5, 3.4],
    soft_speed_limits: [0.1, 1.7],
    ball_position_limit: 2.0,
    ball_velocity_limit: 2.0,
    ball_jump_distance: 0.2,
    ball_position_scale: 0.1,
    ball_velocity_scale: 0.1,
    target_speed_scale: 0.1,
    shift_direction_degrees: [80.0, 100.0],
    shift_foot_distance: [0.16, 0.22],
    shift_ball_distance: [0.06, 0.15],
    shift_distance: 0.04,
  },
  get_up: {
    front_duration_seconds: 5.25,
    back_duration_seconds: 6.0,
    progress_rate: 1.5,
  },
