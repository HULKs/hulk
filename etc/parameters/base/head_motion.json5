{
  joint_control: {
    // Active position/velocity feedback gains, local to head motion.
    kp: { yaw: 10.0, pitch: 10.0 },
    kd: { yaw: 1.2, pitch: 1.2 },
    // rad/s. The velocity ceiling is 2*pi for each joint.
    maximum_velocity: { yaw: 6.283185307, pitch: 6.283185307 },
    // Provisional tuning values: validate acceleration, jerk and damping on K1.
    // rad/s^2 and rad/s^3; acceleration ramps over 0.1 s at these limits.
    maximum_acceleration: { yaw: 20.0, pitch: 20.0 },
    maximum_jerk: { yaw: 200.0, pitch: 200.0 },
    damping_kd: { yaw: 1.2, pitch: 1.2 },
    position_tolerance: { yaw: 0.02, pitch: 0.02 },
    velocity_tolerance: { yaw: 0.05, pitch: 0.05 },
    arrival_exit_factor: 1.5,
    reseed_after: { secs: 0, nanos: 100000000 },
    warning_interval: { secs: 1, nanos: 0 },
  },

  center_head_position: { yaw: 0.0, pitch: 0.5 },

  maximum_defender_velocity: { yaw: 2.0, pitch: 0.8 },
  injected_head_joints: null,

  glance_angle: 0.25,
  image_region_parameters: {
    bottom: [0.5, 0.85],
    center: [0.5, 0.5],
    top: [0.5, 0.15],
  },
  glance_direction_toggle_interval: { secs: 1, nanos: 0 },

  look_around: {
    // Localization: side -> center -> opposite side -> center.
    center: { yaw: 0.0, pitch: 0.7 },
    left: { yaw: 0.95, pitch: 0.5 },
    right: { yaw: -0.95, pitch: 0.5 },
    // Desired travel speeds (rad/s), not transition intervals. Tune on K1.
    travel_speed: { yaw: 1.5, pitch: 0.5 },
    dwell_duration: { secs: 1, nanos: 0 },
    maximum_waypoint_duration: { secs: 2, nanos: 0 },
  },
  search_for_lost_ball: {
    // Center once, then alternate sides without stopping at center.
    center: { yaw: 0.0, pitch: 0.7 },
    left: { yaw: 0.95, pitch: 0.7 },
    right: { yaw: -0.95, pitch: 0.7 },
    travel_speed: { yaw: 1.5, pitch: 0.5 },
    dwell_duration: { secs: 0, nanos: 200000000 },
    maximum_waypoint_duration: { secs: 2, nanos: 500000000 },
  },
}
