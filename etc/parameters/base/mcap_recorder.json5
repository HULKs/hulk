{
  enable: true,
  max_duration: { secs: 3600, nanos: 0 },
  include_raw_images: true,
  raw_image_min_interval: { secs: 0, nanos: 500000000 },
  queue_depth: 8,
  schema_discovery_timeout: { secs: 15, nanos: 0 },
  topics: [
    "ball_state",
    "behavior/blackboard",
    "behavior/motion_command",
    "behavior/trace",
    "camera_geometry",
    "camera_matrix",
    "debug/global_localization",
    "debug/solve_diagnostics",
    "debug/visual_odometry/previous_left_camera_to_current_left_camera",
    "detected_objects",
    "detected_objects/announce",
    "field_mark_association/visual_localization_local",
    "filtered_game_controller_state",
    "ground_to_robot",
    "head_joints_command",
    "inputs/booster_odometry",
    "inputs/low_state",
    "inputs/odometry",
    "is_safe_pose",
    "localization/estimate",
    "localization/status",
    "look_around_target_joints",
    "look_at",
    "outputs/message",
    "primary_state",
    "robot_kinematics",
    "support_foot_state",
    "visual_kick/ball_position",
    "visual_odometry/current_left_camera_to_visual_odometer",
  ],
}
