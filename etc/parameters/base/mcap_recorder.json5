{
  enable: true,
  max_duration: { secs: 3600, nanos: 0 },
  include_images: true,
  image_min_interval: { secs: 0, nanos: 100000000 },
  queue_depth: 8,
  schema_discovery_timeout: { secs: 15, nanos: 0 },
  topics: [
    "player_number",
    "field_dimensions",
    "walking_velocity_limits",
    "inputs/low_state",
    "inputs/fall_down_state",
    "fall_detection/status",
    "robot_kinematics",
    "joint_limits",
    "inputs/odometry",
    "inputs/booster_odometry",
    "support_foot_state",
    "system/tegrastats",
    "system/disk_io",
    "system/network_io",
    "ground_to_robot",
    "camera_matrix",
    "camera_geometry",
    "detected_objects",
    "detected_objects/announce",
    "behavior/motion_command",
    "commands/robot_command",
    "motion_inference/status",
    "motion_inference/timing",
    "motion_inference/trace",
    "primary_state",
    "visual_odometry/current_left_camera_to_visual_odometer",
    "debug/visual_odometry/previous_left_camera_to_current_left_camera",
    "debug/global_localization",
    "field_mark_association/visual_localization_local",
    "localization/estimate",
    "localization/status",
    "debug/solve_diagnostics",
    "behavior/blackboard",
    "behavior/trace",
    "outputs/message",
    "visual_kick/ball_position",
    "ball_state",
    "filtered_game_controller_state",
  ],
}
