{
  disable_heatmap_search: false,
  // The transverse cell count follows the field aspect ratio.
  cells_along_field_length: 28,
  minimum_search_priority: 0.4,
  fallback_minimum_search_priority: 0.05,
  exhausted_search_delay: { secs: 5, nanos: 0 },

  hypothesis_priority_scale: 1.0,
  team_ball_priority: 1.0,
  // Rule rise time means seconds to add one priority unit.
  rule_priority_rise_time: { secs: 16, nanos: 0 },

  // Rise times describe seconds to add one priority unit.
  unseen_priority_rise_time: { secs: 100, nanos: 0 },
  last_ball_extra_priority_rise_time: { secs: 25, nanos: 0 },
  last_ball_priority_fade_time: { secs: 10, nanos: 0 },

  // Last-ball influence spreads in metres per second, then fades away.
  last_ball_initial_half_distance: 2.0,
  last_ball_spread_speed: 0.2,
  observation_distance_range: { start: 0.0, end: 6.0 },

  // Half-lives are interpolated linearly between the range endpoints.
  observation_half_life_near: { secs: 0, nanos: 300000000 },
  observation_half_life_far: { secs: 2, nanos: 500000000 },
  teammate_observation_weight: 0.75,
  occluded_observation_weight: 0.05,
  // Desired maximum sample spacing; replay is capped at four samples per message interval.
  teammate_replay_step: { secs: 0, nanos: 400000000 },

  turn_preference_priority_margin: 0.1,
  border_view_penalty: 0.15,
  border_view_penalty_width_fraction: 0.33333334,
  tile_switch_hysteresis: 0.7,
}
