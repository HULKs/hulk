{
  // Search the full useful sight range on the 14 x 9 m middle field.
  heatmap_decay_range: {
    end: 5.0,
  },
  // At 50 search updates per second, the old factors also cleared distant
  // visible cells quickly. Keep unexplored targets useful while scanning.
  decay_distance_factor: 0.025,
  teammate_decay_factor: 0.008,
  // A last-seen ball should guide the search without continually refilling
  // already scanned cells or raising the entire field to the same priority.
  last_ball_priority_minimum: 0.1,
  last_ball_priority_rise_time: {
    secs: 60,
  },
  // Hold a target until another tile is materially better at low priorities.
  tile_switch_hysteresis: 0.7,
}
