#!/usr/bin/env python3
"""Run independent offline tuner searches in an isolated remote workspace.

start uploads a source/data snapshot and starts continuous, finite search rounds.
status and fetch use the local manifest printed by start. No shared checkout is
modified, and no process is stopped. Twix progress and live simulator parameter
application use the bridge command together with a local simulator preview.
"""
import argparse
import concurrent.futures
import hashlib
import io
import json
import math
import os
from pathlib import Path
import re
import shlex
import shutil
import subprocess
import struct
import sys
import tarfile
import threading
import time
import uuid

DATA_FILES = [f"train-{seed}.mcap" for seed in (42, 43, 142, 143)] + [
    f"validation-{seed}.mcap" for seed in (4243, 4250)
] + ["baseline.json5"]
TASK_BASE = ".cache/hulk-ball-filter-tuning"


def checked_name(value):
    if not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9_.-]{0,95}", value):
        raise ValueError("run name must contain only letters, digits, dots, underscores and hyphens")
    return value


def ssh_command(host, arguments):
    if not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9_.@-]*", host):
        raise ValueError("host must be an SSH alias or user@hostname")
    control = Path.home() / ".cache/hbf-tuning-ssh" / "%C"
    return ["ssh", "-oBatchMode=yes", "-oConnectTimeout=10", "-oControlMaster=auto",
            "-oControlPersist=30m", "-oServerAliveInterval=5", "-oServerAliveCountMax=3", f"-oControlPath={control}", "--", host, shlex.join(arguments)]


def ssh(host, arguments, **kwargs):
    control_directory = Path.home() / ".cache/hbf-tuning-ssh"
    if control_directory.is_symlink():
        raise ValueError("SSH control directory must not be a symlink")
    control_directory.mkdir(mode=0o700, parents=True, exist_ok=True)
    control_directory.chmod(0o700)
    try:
        return subprocess.run(ssh_command(host, arguments), check=True, **kwargs)
    except subprocess.CalledProcessError as error:
        # Resource probes capture stderr; expose authentication failures rather
        # than reporting only an opaque subprocess exit status.
        if error.stderr:
            message = error.stderr.decode(errors="replace") if isinstance(error.stderr, bytes) else error.stderr
            print(message.rstrip(), file=sys.stderr)
        raise


def atomic_json(path, value):
    temporary = path.with_suffix(".tmp")
    temporary.write_text(json.dumps(value, indent=2) + "\n")
    temporary.replace(path)


def digest(path):
    with path.open("rb") as source:
        return hashlib.file_digest(source, "sha256").hexdigest()


def capacity(resources, requested, full_cpu=False):
    # Leave two GiB and, by default, CPU headroom. Each worker may hold all six
    # decoded recordings; budget two GiB per worker rather than just MCAP size.
    memory_slots = (resources["available_bytes"] - 2 * 1024**3) // (2 * 1024**3)
    if memory_slots < 1:
        raise ValueError("remote host has less than 4 GiB available; refusing to add tuner jobs")
    idle_cpus = max(1, math.floor(resources["cpus"] - resources["load"]))
    cpu_limit = resources["cpus"] if full_cpu else min(max(1, resources["cpus"] // 2), idle_cpus)
    return min(requested, cpu_limit, memory_slots)


PROBE = r'''
import json, os
from pathlib import Path
memory = dict(line.split(':', 1) for line in Path('/proc/meminfo').read_text().splitlines())
print(json.dumps({'cpus': len(os.sched_getaffinity(0)),
                  'load': os.getloadavg()[0],
                  'available_bytes': int(memory['MemAvailable'].split()[0]) * 1024}))
'''


def source_paths(repository):
    result = subprocess.check_output(
        ["git", "ls-files", "-z", "--cached", "--others", "--exclude-standard"], cwd=repository
    )
    for name in sorted(set(result.decode().split("\0")) - {""}):
        path = Path(name)
        if any(part in {".git", "target", "logs", "__pycache__"} for part in path.parts):
            continue
        source = repository / path
        if source.is_symlink():
            if os.path.isabs(os.readlink(source)) or not source.resolve().is_relative_to(repository):
                raise ValueError(f"source symlink leaves snapshot: {path}")
        if source.is_file() or source.is_symlink():
            yield path


def snapshot(repository, recordings, initial, local, manifest):
    archive = local / "snapshot.tar.gz"
    source_hash = hashlib.sha256()
    manifest["data_sha256"] = {}
    with tarfile.open(archive, "w:gz") as bundle:
        for relative in source_paths(repository):
            source = repository / relative
            checksum = hashlib.sha256(os.readlink(source).encode()).hexdigest() if source.is_symlink() else digest(source)
            source_hash.update(relative.as_posix().encode() + b"\0" + checksum.encode() + b"\0")
            bundle.add(source, arcname=f"source/{relative.as_posix()}", recursive=False)
        for name in DATA_FILES + (["initial.json5"] if initial else []):
            source = initial if name == "initial.json5" else recordings / name
            manifest["data_sha256"][name] = digest(source)
            bundle.add(source.resolve(), arcname=f"data/{name}", recursive=False)
        manifest["source_sha256"] = source_hash.hexdigest()
        bundle.add(Path(__file__).resolve(), arcname="controller.py", recursive=False)
        encoded = json.dumps(manifest, indent=2).encode()
        info = tarfile.TarInfo("manifest.json")
        info.size = len(encoded)
        bundle.addfile(info, io.BytesIO(encoded))
    manifest["snapshot_sha256"] = digest(archive)
    atomic_json(local / "manifest.json", manifest)
    return archive


TMUX_LAUNCH = """import shlex, subprocess, sys
from pathlib import Path
root = Path.home()/sys.argv[1]
session = sys.argv[2]
command = shlex.join([sys.executable, '-u', str(root/'controller.py'), '_run'])
command += ' 2>&1 | tee -a ' + shlex.quote(str(root/'controller.log'))
subprocess.run(['tmux', 'new-session', '-d', '-s', session, '-c', str(root),
                shlex.join(['bash', '-lc', 'set -o pipefail; ' + command])], check=True)
subprocess.run(['tmux', 'set-option', '-w', '-t', '=' + session + ':', 'remain-on-exit', 'on'], check=True)
print(subprocess.check_output(['tmux', 'display-message', '-p', '-t', '=' + session + ':', '#{pane_pid}'], text=True).strip())
"""

def start(args):
    repository = Path(__file__).resolve().parent.parent
    recordings = args.recordings.resolve()
    for name in DATA_FILES:
        if not (recordings / name).is_file():
            raise ValueError(f"missing recording input: {recordings / name}")
    if args.initial_parameters and not args.initial_parameters.is_file():
        raise ValueError("initial parameters file does not exist")
    run = checked_name(args.name or time.strftime("%Y%m%d-%H%M%S-") + uuid.uuid4().hex[:8])
    local = (args.local_directory or repository / "logs" / f"remote-ball-tuning-{run}").resolve()
    resources = json.loads(ssh(args.host, ["python3", "-c", PROBE], capture_output=True, text=True).stdout)
    workers = capacity(resources, args.workers, args.full_cpu)
    # Authentication failures should not reserve an empty local run directory.
    local.mkdir(parents=True, exist_ok=False)
    manifest = dict(
        run=run, host=args.host, remote=f"{TASK_BASE}/runs/{run}",
        tmux_session="ball-filter-" + run.replace(".", "_") + "-" + hashlib.sha256(run.encode()).hexdigest()[:8],
        git_head=subprocess.check_output(["git", "rev-parse", "HEAD"], cwd=repository, text=True).strip(),
        workers=workers, build_jobs=capacity(resources, args.build_jobs, args.full_cpu), toolchain=args.toolchain,
        full_cpu=args.full_cpu,
        trials=args.trials, seed=args.seed,
        initial=bool(args.initial_parameters), resources=resources,
        reference_frame=args.reference_frame, reference_topic=args.reference_topic,
        namespace=args.namespace,
        controller_protocol=1, control_token=uuid.uuid4().hex,
        start_paused=getattr(args, "paused", False), recordings_directory=str(recordings),
    )
    archive = snapshot(repository, recordings, args.initial_parameters, local, manifest)
    # mkdir without exist_ok makes each remote run exclusive. All writes stay in
    # our own cache subtree; the existing .REMOTE_WORKSPACE is deliberately ignored.
    prepare = "from pathlib import Path; import sys; p=Path.home()/sys.argv[1]; p.parent.mkdir(parents=True, exist_ok=True); p.mkdir()"
    ssh(args.host, ["python3", "-c", prepare, manifest["remote"]])
    with archive.open("rb") as stream:
        ssh(args.host, ["tar", "-xzf", "-", "-C", manifest["remote"]], stdin=stream)

    pid = ssh(args.host, ["python3", "-c", TMUX_LAUNCH, manifest["remote"], manifest["tmux_session"]], capture_output=True, text=True).stdout.strip()
    manifest["tmux_pane_pid"] = int(pid)
    atomic_json(local / "manifest.json", manifest)
    print(f"Controller started/building; {workers} workers planned, {args.trials} trials per continuous round.")
    print(f"Manifest: {local / 'manifest.json'}")
    print("Attach: " + shlex.join(["ssh", "-t", args.host, "tmux", "attach-session", "-t", "=" + manifest["tmux_session"]]))
    print("Use bridge or the ball_filter_optimization launcher for Twix and local live preview.")


def tuner_command(root, manifest, worker, round_number, initial):
    output = root / "results" / f"worker-{worker:02d}" / f"round-{round_number:06d}"
    arguments = [str(root / "bin/ball-filter-tuner"), "--parameters", str(root / "data/baseline.json5"),
                 "--train", *[str(root / "data" / name) for name in DATA_FILES[:4]],
                 "--validation", *[str(root / "data" / name) for name in DATA_FILES[4:6]],
                 "--reference-frame", manifest["reference_frame"],
                 "--reference-topic", manifest["reference_topic"], "--namespace", manifest["namespace"],
                 "--trials", str(manifest["trials"]), "--seed", str(manifest["seed"] + worker * 1_000_003 + round_number),
                 "--output", str(output)]
    if initial:
        arguments += ["--initial-parameters", str(initial)]
    return arguments, output


def training_loss(report):
    if report.get("replay_matches_live") is not True or not isinstance(report.get("continuity_policy"), str) or not report["continuity_policy"]:
        raise ValueError("report lacks exact replay verification or training continuity policy")
    loss = report["training"]["optimized"]["loss"]
    if not math.isfinite(loss):
        raise ValueError("nonfinite training loss")
    return loss


def run_remote():
    import fcntl
    root = Path(__file__).resolve().parent
    manifest = json.loads((root / "manifest.json").read_text())
    state = root / "status.json"
    atomic_json(state, {"state": "building", "pid": os.getpid(), "tmux_session": manifest["tmux_session"]})
    print(f"Building tuner with Rust {manifest['toolchain']}; follow {root / 'build.log'}", flush=True)
    try:
        # Share only this helper's build cache, serialize build+copy, and give
        # every immutable run its own executable before starting any workers.
        cache = Path.home() / TASK_BASE
        cache.mkdir(exist_ok=True)
        with (cache / "build.lock").open("a") as lock, (root / "build.log").open("w") as log:
            fcntl.flock(lock, fcntl.LOCK_EX)
            environment = dict(os.environ, CARGO_TARGET_DIR=str(cache / "target"))
            subprocess.run(["cargo", "+" + manifest["toolchain"], "build", "--release", "--locked", "-j", str(manifest["build_jobs"]),
                            "-p", "ball-filter-tuner"], cwd=root / "source", env=environment,
                           stdout=log, stderr=subprocess.STDOUT, check=True)
            (root / "bin").mkdir()
            shutil.copy2(cache / "target/release/ball-filter-tuner", root / "bin/ball-filter-tuner")
        atomic_json(root / "environment.json", {
            "rustc": subprocess.check_output(["rustc", "+" + manifest["toolchain"], "--version"], text=True).strip(),
            "binary_sha256": digest(root / "bin/ball-filter-tuner"),
        })
        if manifest.get("start_paused"):
            atomic_json(state, {"state": "ready", "workers": manifest["workers"], "pid": os.getpid(),
                                "tmux_session": manifest["tmux_session"]})
            print("Build ready; waiting for explicit activation before starting workers.", flush=True)
            while not (root / "activate.requested").exists() and not (root / "stop.requested").exists():
                time.sleep(0.2)
        if (root / "stop.requested").exists():
            atomic_json(state, {"state": "stopped", "workers": 0, "pid": os.getpid()})
            return
        atomic_json(state, {"state": "searching", "workers": manifest["workers"], "pid": os.getpid(),
                            "tmux_session": manifest["tmux_session"]})
        print(f"Build complete; starting {manifest['workers']} continuous workers.", flush=True)
        best_lock = threading.Lock()
        best_loss = math.inf

        def worker(index):
            nonlocal best_loss
            initial = root / "data/initial.json5" if manifest["initial"] else None
            round_number = 0
            worker_state = root / f"worker-{index:02d}.json"
            while not (root / "stop.requested").exists():
                round_number += 1
                command, output = tuner_command(root, manifest, index, round_number, initial)
                output.parent.mkdir(parents=True, exist_ok=True)
                print(f"Worker {index}: starting round {round_number}; log {output.with_suffix('.log')}", flush=True)
                atomic_json(worker_state, {"state": "searching", "round": round_number, "output": str(output.relative_to(root))})
                try:
                    with output.with_suffix(".log").open("w") as log:
                        subprocess.run(command, cwd=root / "source", stdout=log, stderr=subprocess.STDOUT, check=True)
                    report = json.loads((output / "report.json").read_text())
                    loss = training_loss(report)
                    atomic_json(output / "complete.json", {"training_loss": loss})
                    print(f"Worker {index}: completed round {round_number}, training loss {loss:.6f}", flush=True)
                    with best_lock:
                        if loss < best_loss:
                            best_loss = loss
                            print(f"New training best: worker {index}, round {round_number}, loss {loss:.6f}", flush=True)
                            atomic_json(root / "best.json", {"training_loss": loss, "output": str(output.relative_to(root)),
                                                             "worker": index, "round": round_number})
                    initial = output / "ball_filter.json5"
                except Exception as error:
                    print(f"Worker {index} failed: {error}", flush=True)
                    atomic_json(worker_state, {"state": "failed", "round": round_number, "error": str(error),
                                               "log": str(output.with_suffix('.log').relative_to(root))})
                    raise
            atomic_json(worker_state, {"state": "stopped", "round": round_number,
                                       "reason": "cooperative stop after completed round"})
            print(f"Worker {index}: stopped after round {round_number}; checkpoints retained.", flush=True)

        failed_workers = []
        with concurrent.futures.ThreadPoolExecutor(max_workers=manifest["workers"]) as executor:
            futures = [executor.submit(worker, index) for index in range(manifest["workers"])]
            for future in concurrent.futures.as_completed(futures):
                try:
                    future.result()
                except Exception as error:
                    failed_workers.append(str(error))
                    atomic_json(state, {"state": "worker failed; inspect worker statuses", "error": str(error), "pid": os.getpid()})
        atomic_json(state, {"state": "stopped" if (root / "stop.requested").exists() else "failed",
                            "workers": 0, "failed_workers": failed_workers, "pid": os.getpid()})
    except Exception as error:
        print(f"Controller failed: {error}", flush=True)
        atomic_json(state, {"state": "failed", "error": str(error), "log": "build.log"})
        raise



CONTROL = r'''
import json, sys
from pathlib import Path
root = Path.home()/sys.argv[1]
expected_run, token, action = sys.argv[2:]
manifest = json.loads((root/'manifest.json').read_text())
if manifest.get('controller_protocol') != 1 or manifest.get('run') != expected_run or manifest.get('control_token') != token:
    raise ValueError('controller ownership/protocol does not match; legacy runs cannot be controlled')
status_path = root/'status.json'
status = json.loads(status_path.read_text()) if status_path.exists() else {'state': 'starting'}
if status['state'] in ('ready', 'searching', 'building'):
    try:
        argv = (Path('/proc')/str(status.get('pid', 0))/'cmdline').read_bytes().split(b'\0')
        alive = str(root/'controller.py').encode() in argv and b'_run' in argv
    except (FileNotFoundError, PermissionError):
        alive = False
    if not alive:
        status['state'] = 'controller exited'
if action == 'stop':
    (root/'stop.requested').touch(exist_ok=True)
elif action == 'activate':
    if (root/'stop.requested').exists() or status['state'] not in ('ready', 'searching'):
        raise ValueError('only a ready, non-stopping generation can be activated')
    (root/'activate.requested').touch(exist_ok=True)
elif action != 'status':
    raise ValueError('unknown controller action')
status['stop_requested'] = (root/'stop.requested').exists()
print(json.dumps(status))
'''


def controlled_manifest(path):
    manifest = json.loads(path.read_text())
    checked_name(manifest['run'])
    if manifest.get('controller_protocol') != 1 or not re.fullmatch(r'[0-9a-f]{32}', manifest.get('control_token', '')):
        raise ValueError('this run has no cooperative ownership protocol; legacy runs are monitor-only')
    return manifest


def control_once(manifest, action):
    run = checked_name(manifest['run'])
    result = ssh(manifest['host'], ['python3', '-c', CONTROL, f'{TASK_BASE}/runs/{run}',
                 run, manifest['control_token'], action], capture_output=True, text=True, timeout=30)
    return json.loads(result.stdout)


def control(args):
    manifest = controlled_manifest(args.manifest)
    action = 'status' if args.command == 'wait-ready' else args.command
    status = control_once(manifest, action)
    if args.command == 'activate' or (args.command == 'stop' and not args.wait):
        print(json.dumps(status), flush=True)
        return
    wanted = {'ready', 'searching'} if args.command == 'wait-ready' else {'stopped'}
    deadline = time.monotonic() + args.timeout
    last_state = None
    while True:
        state = status.get('state')
        if state != last_state:
            print(f"{manifest['run']}: {state}", flush=True)
            last_state = state
        if state in wanted:
            return
        if state in {'failed', 'controller exited'} or (args.command == 'wait-ready' and state == 'stopped'):
            raise ValueError(f"remote generation {manifest['run']} is {state}: {status}")
        if time.monotonic() >= deadline:
            raise ValueError(f"timed out waiting for {manifest['run']} to reach {sorted(wanted)}; checkpoints retained")
        time.sleep(1)
        status = control_once(manifest, 'status')

def export_results():
    root = Path(__file__).resolve().parent
    with tarfile.open(fileobj=sys.stdout.buffer, mode="w|gz") as bundle:
        for name in ["manifest.json", "status.json", "best.json", "environment.json", "build.log", "controller.log"]:
            if (root / name).is_file():
                bundle.add(root / name, arcname=name)
        for path in root.glob("worker-*.json"):
            bundle.add(path, arcname=path.name)
        # Full scans also detect changed/malformed historical checkpoints. For
        # long-running searches, cache immutable validated rounds incrementally;
        # scanning thousands of reports every poll will eventually dominate I/O.
        for marker in sorted((root / "results").glob("worker-*/round-*/complete.json")):
            # The controller commits this marker after the tuner exits successfully.
            for name in ["report.json", "ball_filter.json5", "complete.json"]:
                path = marker.parent / name
                bundle.add(path, arcname=str(path.relative_to(root)))


def inspect_or_fetch(args):
    manifest = json.loads(args.manifest.read_text())
    run = checked_name(manifest["run"])
    remote = f"{TASK_BASE}/runs/{run}"
    if args.command == "status":
        command = """import json,sys
from pathlib import Path
root=Path.home()/sys.argv[1]
for path in [root/'status.json', root/'best.json', *sorted(root.glob('worker-*.json'))]:
    if path.is_file(): print(path.name+': '+path.read_text().strip())
"""
        ssh(manifest["host"], ["python3", "-c", command, remote])
        return
    output = args.output or args.manifest.resolve().parent / ("fetched-" + time.strftime("%Y%m%d-%H%M%S-") + uuid.uuid4().hex[:6])
    output.mkdir(parents=True, exist_ok=False)
    archive = output / "results.tar.gz"
    with archive.open("wb") as destination:
        ssh(manifest["host"], ["python3", f"{remote}/controller.py", "_export"], stdout=destination)
    with tarfile.open(archive) as bundle:
        for member in bundle:
            relative = Path(member.name)
            if relative.is_absolute() or ".." in relative.parts or not member.isfile():
                raise ValueError(f"unsafe result archive entry: {member.name}")
            destination = output / relative
            destination.parent.mkdir(parents=True, exist_ok=True)
            with bundle.extractfile(member) as source, destination.open("xb") as target:
                shutil.copyfileobj(source, target)
    reports = list((output / "results").glob("worker-*/round-*/report.json"))
    if reports:
        best = min(reports, key=lambda path: training_loss(json.loads(path.read_text())))
        atomic_json(output / "selected.json", {"report": str(best.relative_to(output)),
                                              "selection": "minimum training loss among continuity-guarded verified reports; holdout never used"})
        print(f"Selected report: {best}")
    print(f"Fetched: {output}")


METRIC_FIELDS = (
    "loss", "position_rmse_metres", "missing_seconds", "missing_runs", "longest_missing_seconds",
    "close_range_position_rmse_metres", "close_range_present_seconds", "close_range_missing_seconds",
    "along_motion_error_metres", "motion_lag_seconds", "moving_reference_seconds",
    "false_track_seconds", "missing_transform_seconds",
)
OPTIONAL_METRICS = {"position_rmse_metres", "close_range_position_rmse_metres", "along_motion_error_metres", "motion_lag_seconds"}


def unsigned(value):
    if type(value) is not int or not 0 <= value < 2**64:
        raise ValueError(f"expected unsigned 64-bit integer, got {value!r}")
    return value


def finite_json(value):
    if isinstance(value, dict):
        for item in value.values():
            finite_json(item)
    elif isinstance(value, list):
        for item in value:
            finite_json(item)
    elif isinstance(value, float) and not math.isfinite(value):
        raise ValueError("nonfinite value in remote result")


def progress_metrics(score):
    metrics = {key: score[key] for key in METRIC_FIELDS}
    for key, value in metrics.items():
        if value is None and key in OPTIONAL_METRICS:
            continue
        if type(value) not in (float, int) or not math.isfinite(value):
            raise ValueError(f"invalid {key} metric")
        if key not in {"along_motion_error_metres", "motion_lag_seconds"} and value < 0:
            raise ValueError(f"negative {key} metric")
    unsigned(metrics["missing_runs"])
    return metrics


def parameter_shape(value, baseline):
    if isinstance(baseline, dict):
        return isinstance(value, dict) and value.keys() == baseline.keys() and all(
            parameter_shape(value[key], item) for key, item in baseline.items())
    if isinstance(baseline, list):
        return isinstance(value, list) and len(value) == len(baseline) and all(
            parameter_shape(a, b) for a, b in zip(value, baseline))
    if type(baseline) in (int, float):
        return type(value) in (int, float) and math.isfinite(value)
    return type(value) is type(baseline)



def parameters_equal(left, right):
    # Reports/configs can pass through different serde_json float formatting.
    # BallFilterParameters uses f32 leaves; compare their native bit patterns,
    # while keeping integer duration/count fields exact.
    if isinstance(left, dict):
        return isinstance(right, dict) and left.keys() == right.keys() and all(
            parameters_equal(value, right[key]) for key, value in left.items())
    if isinstance(left, list):
        return isinstance(right, list) and len(left) == len(right) and all(
            parameters_equal(a, b) for a, b in zip(left, right))
    if type(left) is float and type(right) is float:
        return math.isfinite(left) and math.isfinite(right) and struct.pack("!f", left) == struct.pack("!f", right)
    return type(left) is type(right) and left == right

def report_compatibility(report):
    finite_json(report)
    training_loss(report)
    if report["reference_frame"] not in {"ground", "field"}:
        raise ValueError("unknown reference frame")
    if not isinstance(report["objective"], dict) or not isinstance(report["objective"]["version"], str):
        raise ValueError("missing objective version")
    for partition in ("training", "validation"):
        for variant in ("baseline", "optimized"):
            progress_metrics(report[partition][variant])
    baseline = report["baseline_parameters"]
    if not isinstance(baseline, dict) or not baseline or not parameter_shape(report["optimized_parameters"], baseline):
        raise ValueError("candidate parameter schema differs from baseline")
    return {key: report[key] for key in (
        "objective", "namespace", "reference_frame", "reference_topic", "penalty_metres",
        "baseline_parameters", "continuity_policy", "retention_policy", "tuned_parameter_pointers",
    )} | {"training_baseline": report["training"]["baseline"], "validation_baseline": report["validation"]["baseline"]}



def controller_alive(root, status, proc=Path("/proc")):
    pid = status.get("pid")
    if pid is None:
        return None
    if unsigned(pid) == 0:
        return False
    try:
        arguments = (proc / str(pid) / "cmdline").read_bytes().split(b"\0")
    except FileNotFoundError:
        return False
    # A reused PID must not make an unrelated process look like our controller.
    return str(root / "controller.py").encode() in arguments and b"_run" in arguments

def read_remote_runs(run_names, base=None):
    """Read-only inspection, also executed remotely without updating controllers."""
    base = base or Path.home() / TASK_BASE / "runs"
    results = []
    for name in run_names:
        root = base / checked_name(name)
        manifest = json.loads((root / "manifest.json").read_text())
        control = json.loads((root / "status.json").read_text()) if (root / "status.json").exists() else {}
        environment = json.loads((root / "environment.json").read_text()) if (root / "environment.json").exists() else None
        alive = controller_alive(root, control)
        workers = []
        for worker in range(unsigned(manifest["workers"])):
            path = root / f"worker-{worker:02d}.json"
            state = json.loads(path.read_text()) if path.exists() else {}
            status = state.get("state", control.get("state", "preparing"))
            if not isinstance(status, str):
                raise ValueError(f"invalid worker status in {path}")
            if alive is False and status in {"searching", "building", "preparing", "ready"}:
                status = "controller exited"
            workers.append(dict(run=name, worker=worker, round=unsigned(state.get("round", 0)), status=status))
        completed_trials, best, compatibility = 0, None, None
        for marker in sorted((root / "results").glob("worker-*/round-*/complete.json")):
            match = re.fullmatch(r"worker-(\d+)/round-(\d+)/complete.json", marker.relative_to(root / "results").as_posix())
            if not match:
                raise ValueError(f"invalid completed round path: {marker}")
            worker, round_number = map(int, match.groups())
            if worker >= len(workers) or round_number < 1:
                raise ValueError(f"completed round outside declared workers: {marker}")
            report = json.loads((marker.parent / "report.json").read_text())
            params = json.loads((marker.parent / "ball_filter.json5").read_text())
            loss = training_loss(report)
            if json.loads(marker.read_text())["training_loss"] != loss or not parameters_equal(params, report["optimized_parameters"]):
                raise ValueError(f"inconsistent completed checkpoint: {marker}")
            signature = report_compatibility(report)
            if compatibility is not None and signature != compatibility:
                raise ValueError(f"incompatible completed reports in {name}")
            compatibility = signature
            trials = unsigned(report["trials"])
            if trials != manifest["trials"] or trials == 0:
                raise ValueError(f"completed round trial count mismatch: {marker}")
            for field, names in (("training_recordings", DATA_FILES[:4]), ("validation_recordings", DATA_FILES[4:6])):
                if [Path(path).name for path in report[field]] != names:
                    raise ValueError(f"recording partition mismatch: {marker}")
            if any(report[key] != manifest[key] for key in ("namespace", "reference_frame", "reference_topic")):
                raise ValueError(f"reference configuration mismatch: {marker}")
            completed_trials += trials
            if best is None or loss < training_loss(best["report"]):
                best = dict(worker=worker, round=round_number, report=report)
        if best is not None and not environment:
            raise ValueError(f"completed rounds lack binary provenance: {name}")
        results.append(dict(manifest=manifest, environment=environment, workers=workers,
                            completed_trials=unsigned(completed_trials), compatibility=compatibility, best=best))
    return results


_INSPECTION_CODE = None


def bridge_inspection_command(run_names):
    # Freeze source while it still corresponds to the imported functions. Later
    # workspace edits can move their lines; asking inspect.getsource each poll
    # would then send unrelated/invalid code from the modified file.
    global _INSPECTION_CODE
    if _INSPECTION_CODE is None:
        import inspect
        functions = (checked_name, training_loss, unsigned, finite_json, progress_metrics,
                     parameter_shape, parameters_equal, report_compatibility, controller_alive, read_remote_runs)
        code = "import json, math, re, struct, sys\nfrom pathlib import Path\n"
        for key in ("TASK_BASE", "DATA_FILES", "METRIC_FIELDS", "OPTIONAL_METRICS"):
            code += f"{key} = {globals()[key]!r}\n"
        code += "\n".join(inspect.getsource(function) for function in functions)
        code += "\nprint(json.dumps(read_remote_runs(sys.argv[1:]), allow_nan=False))\n"
        compile(code, "remote-ball-filter-inspection", "exec")
        _INSPECTION_CODE = code
    return ["python3", "-c", _INSPECTION_CODE, *run_names]


def empty_progress(host):
    return dict(updated_unix_seconds=0.0, error=None,
                remote=dict(host=host, workers=[], completed_trials=0, best_candidate=""), search=None)


def combine_remote_progress(manifests, runs, previous, provenance, now):
    expected = {manifest["run"]: manifest for manifest in manifests}
    if len(expected) != len(manifests) or len(runs) != len(expected):
        raise ValueError("duplicate or missing run manifests")
    host = manifests[0]["host"]
    if any(manifest["host"] != host for manifest in manifests):
        raise ValueError("bridge manifests must use the same SSH host")
    workers, trials, candidates = [], 0, []
    binary_hash = data_hashes = compatibility = None
    seen = set()
    for run in runs:
        manifest = run["manifest"]
        name = manifest["run"]
        if name not in expected or name in seen:
            raise ValueError("unexpected or duplicated remote run")
        seen.add(name)
        for field in ("source_sha256", "data_sha256", "workers", "trials", "namespace", "reference_frame", "reference_topic"):
            if manifest[field] != expected[name][field]:
                raise ValueError(f"remote manifest mismatch for {name}: {field}")
        hashes = {key: value for key, value in manifest["data_sha256"].items() if key != "initial.json5"}
        if set(hashes) != set(DATA_FILES) or any(not re.fullmatch(r"[0-9a-f]{64}", value) for value in hashes.values()):
            raise ValueError(f"missing or invalid dataset hashes for {name}")
        if data_hashes is not None and hashes != data_hashes:
            raise ValueError("cannot combine runs with different recording/baseline hashes")
        data_hashes = hashes
        if run["environment"] is not None:
            digest_value = run["environment"]["binary_sha256"]
            if not re.fullmatch(r"[0-9a-f]{64}", digest_value):
                raise ValueError(f"invalid binary hash for {name}")
            if binary_hash is not None and digest_value != binary_hash:
                raise ValueError("cannot combine different filter/scoring binaries")
            binary_hash = digest_value
        workers.extend(run["workers"])
        trials += unsigned(run["completed_trials"])
        if run["best"] is not None:
            signature = report_compatibility(run["best"]["report"])
            if signature != run["compatibility"] or (compatibility is not None and signature != compatibility):
                raise ValueError("cannot combine different objective/reference/baseline policies")
            compatibility = signature
            candidate = run["best"]
            identity = f"{host}/{name}/worker-{candidate['worker']:02d}/round-{candidate['round']:06d}"
            candidates.append((identity, candidate["report"]))
    if trials < previous["remote"]["completed_trials"]:
        raise ValueError("previously completed remote trial slots disappeared")
    fingerprint = dict(binary_sha256=binary_hash, data_sha256=data_hashes, report=compatibility)
    if provenance and provenance != fingerprint:
        raise ValueError("bridge result provenance changed; use a separate output directory")
    snapshot = dict(updated_unix_seconds=now, error=None,
                    remote=dict(host=host, workers=workers, completed_trials=unsigned(trials), best_candidate=""), search=None)
    if candidates:
        identity, report = min(candidates, key=lambda item: (training_loss(item[1]), item[0]))
        # Equal-loss rounds are checkpoints, not new selections. This keeps the
        # local revision and live parameters stable across continuous rounds.
        if previous["search"] and previous["search"]["best"]["loss"] <= training_loss(report):
            snapshot["search"] = dict(previous["search"], trial=trials)
            snapshot["remote"]["best_candidate"] = previous["remote"]["best_candidate"]
        else:
            revision = unsigned(previous["search"]["best_trial"]) + 1 if previous["search"] else 1
            snapshot["search"] = dict(
                reference_frame=report["reference_frame"], trial=trials, trials=0, best_trial=unsigned(revision),
                baseline=progress_metrics(report["training"]["baseline"]), best=progress_metrics(report["training"]["optimized"]),
                best_parameters=report["optimized_parameters"], validation_baseline=progress_metrics(report["validation"]["baseline"]),
                validation_best=progress_metrics(report["validation"]["optimized"]),
            )
            snapshot["remote"]["best_candidate"] = identity
    elif previous["search"]:
        raise ValueError("previously completed remote checkpoints disappeared")
    # Persist provenance only once a verified candidate exists; pending builds
    # must still publish worker status before a binary/report is available.
    return snapshot, fingerprint if candidates else provenance


def poll_bridge(manifests, previous, provenance, now=None):
    try:
        result = ssh(manifests[0]["host"], bridge_inspection_command([item["run"] for item in manifests]),
                     capture_output=True, text=True, timeout=30)
        runs = json.loads(result.stdout)
        return combine_remote_progress(manifests, runs, previous, provenance, time.time() if now is None else now)
    except (ValueError, TypeError, KeyError, OSError, subprocess.SubprocessError) as error:
        if isinstance(error, subprocess.TimeoutExpired):
            message = f"SSH to {manifests[0]['host']} timed out after {error.timeout:g} seconds"
        elif isinstance(error, subprocess.CalledProcessError):
            message = f"SSH to {manifests[0]['host']} failed (exit {error.returncode})"
            if error.stderr:
                detail = error.stderr.decode(errors="replace") if isinstance(error.stderr, bytes) else error.stderr
                message += ": " + detail.strip()[-2000:]
        else:
            message = str(error)
        # A failed SSH poll is not a fresh observation. Preserve the successful
        # timestamp, parameters and progress so the UI can expose their age.
        return dict(previous, error=message), provenance


def bridge(args):
    import fcntl
    manifests = [json.loads(path.read_text()) for path in args.manifests]
    if len({item["host"] for item in manifests}) != 1 or len({item["run"] for item in manifests}) != len(manifests):
        raise ValueError("provide distinct run manifests on one SSH host")
    for item in manifests:
        checked_name(item["run"])
    args.output.mkdir(parents=True, exist_ok=True)
    with (args.output / "bridge.lock").open("a") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        output = args.output / "remote-progress.json"
        state_path = args.output / "bridge-state.json"
        state = json.loads(state_path.read_text()) if state_path.exists() else None
        previous = json.loads(output.read_text()) if output.exists() else empty_progress(manifests[0]["host"])
        identity = {"host": manifests[0]["host"], "runs": sorted(item["run"] for item in manifests)}
        if state and state["identity"] != identity:
            raise ValueError("bridge output belongs to a different run set")
        if previous["search"] and (not state or not state.get("provenance")):
            raise ValueError("existing progress lacks compatibility provenance")
        provenance = state["provenance"] if state else None
        print(f"Bridging {len(manifests)} remote runs into {output}", flush=True)
        while True:
            snapshot, new_provenance = poll_bridge(manifests, previous, provenance)
            if snapshot["error"] != previous["error"] and snapshot["error"]:
                print(f"Remote polling failed: {snapshot['error']}", file=sys.stderr, flush=True)
            atomic_json(state_path, dict(identity=identity, provenance=new_provenance))
            atomic_json(output, snapshot)
            previous, provenance = snapshot, new_provenance
            time.sleep(args.interval)

def main():
    parser = argparse.ArgumentParser(description=__doc__)
    commands = parser.add_subparsers(dest="command", required=True, metavar="{start,status,fetch,bridge,stop,activate,wait-ready}")
    start_parser = commands.add_parser("start")
    start_parser.add_argument("--host", default="remote-compiler")
    start_parser.add_argument("--paused", action="store_true", help="build, then wait for explicit activate before starting workers")
    start_parser.add_argument("--recordings", type=Path, required=True)
    start_parser.add_argument("--initial-parameters", type=Path)
    start_parser.add_argument("--workers", type=int, default=4)
    start_parser.add_argument("--full-cpu", action="store_true",
                              help="allow all logical CPUs regardless of load; retain memory limits (account for existing jobs)")
    start_parser.add_argument("--build-jobs", type=int, default=4)
    start_parser.add_argument("--toolchain", default="1.98.1")
    start_parser.add_argument("--trials", type=int, default=256)
    start_parser.add_argument("--seed", type=int, default=7)
    start_parser.add_argument("--name")
    start_parser.add_argument("--local-directory", type=Path)
    start_parser.add_argument("--reference-frame", choices=["ground", "field"], default="field")
    start_parser.add_argument("--reference-topic", default="simulation/ball_ground_truth_field")
    start_parser.add_argument("--namespace", default="")
    for name in ["status", "fetch"]:
        subparser = commands.add_parser(name)
        subparser.add_argument("manifest", type=Path)
        if name == "fetch":
            subparser.add_argument("--output", type=Path)
    for name in ["stop", "activate", "wait-ready"]:
        subparser = commands.add_parser(name)
        subparser.add_argument("manifest", type=Path)
        subparser.add_argument("--timeout", type=float, default=1800.0)
        if name == "stop":
            subparser.add_argument("--wait", action="store_true", help="wait for all current rounds to finish")
    bridge_parser = commands.add_parser("bridge", help="poll remote workers into an atomic local progress file")
    bridge_parser.add_argument("manifests", nargs="+", type=Path)
    bridge_parser.add_argument("--output", required=True, type=Path)
    bridge_parser.add_argument("--interval", type=float, default=2.0)
    commands.add_parser("_run")
    commands.add_parser("_export")
    args = parser.parse_args()
    if args.command == "start":
        if not 1 <= args.workers <= 32 or not 1 <= args.build_jobs <= 32 or args.trials < 1 or args.seed < 0:
            parser.error("workers/build-jobs must be 1..32, trials positive, and seed nonnegative")
        start(args)
    elif args.command in {"stop", "activate", "wait-ready"}:
        if not math.isfinite(args.timeout) or args.timeout <= 0:
            parser.error("timeout must be finite and positive")
        control(args)
    elif args.command == "bridge":
        if not math.isfinite(args.interval) or args.interval < 0.1:
            parser.error("bridge interval must be finite and at least 0.1 seconds")
        bridge(args)
    elif args.command == "_run":
        run_remote()
    elif args.command == "_export":
        export_results()
    else:
        inspect_or_fetch(args)


if __name__ == "__main__":
    try:
        main()
    except (ValueError, OSError, subprocess.CalledProcessError, subprocess.TimeoutExpired) as error:
        sys.exit(str(error))
