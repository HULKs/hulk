[Unit]
Description=HULK Application Service
Requires=hulk-runtime.service
After=hulk-runtime.service

[Service]
Type=simple
ExecStartPre=/usr/bin/jetson_clocks
ExecStartPre=/nix/var/nix/profiles/hulks/bin/podman wait --condition running hulk
ExecStart=/usr/bin/launch-hulk
ExecStartPost=/bin/sleep 5
ExecStop=/nix/var/nix/profiles/hulks/bin/podman exec hulk sh -ec 'pkill -TERM -x hulk_ros_z || [ $$? -eq 1 ]; pidwait -x hulk_ros_z || [ $$? -eq 1 ]'
KillMode=control-group
KillSignal=SIGTERM
TimeoutStopSec=15
Restart=no

[Install]
WantedBy=multi-user.target
