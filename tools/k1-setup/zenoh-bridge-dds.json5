{
  mode: "peer",
  listen: {
    endpoints: ["tcp/127.0.0.1:7448"],
  },
  connect: {
    endpoints: [],
  },
  scouting: {
    multicast: { enabled: false },
    gossip: { enabled: false },
  },
  transport: {
    shared_memory: {
      enabled: false,
    },
  },
  plugins: {
    dds: {
      localhost_only: true,
      allow: [
        "low_state",
        "joint_states",
        "joint_ctrl",
        "image_left_raw",
        "rectified_image",
        "kick_ball",
        "odometer_state",
        "fall_down",
        "button_event",
        "remote_controller_state",
        "LocoApiTopicReq",
        "LocoApiTopicResp",
        "LightControlApiTopicReq",
        "LightControlApiTopicResp",
      ],
    },
  },
}
