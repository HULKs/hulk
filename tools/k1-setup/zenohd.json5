{
  mode: "peer",
  listen: {
    endpoints: ["tcp/[::]:7447"],
  },
  gateway: {
    south: [
      {
        filters: [
          { modes: ["peer"], region_names: ["robot"] },
        ],
      },
      {
        filters: [
          { modes: ["client"] },
        ],
      },
    ],
  },
  transport: {
    shared_memory: {
      enabled: false,
    },
  },
  qos: {
    network: [
      {
        id: "topic-default-drop",
        flows: ["egress"],
        messages: ["put"],
        key_exprs: ["rt/**"],
        overwrite: { congestion_control: "drop" },
      },
      {
        id: "topic-loopback-block",
        interfaces: ["lo"],
        flows: ["egress"],
        messages: ["put"],
        key_exprs: ["rt/**"],
        overwrite: { congestion_control: "block" },
      },
    ],
  },
}
