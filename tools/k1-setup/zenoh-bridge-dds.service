[Unit]
Description=Zenoh DDS bridge
Requires=zenohd.service
After=zenohd.service

[Service]
CPUAffinity=4 5
# Zenoh SHM objects are accessible only to their owner; match HULK's UID.
User=booster
Group=booster
Environment=ZENOH_HOME=/home/booster/.zenoh
# Zenoh locks its SHM pools and mapped buffers into memory.
LimitMEMLOCK=infinity
ExecStart=/nix/var/nix/profiles/hulks/bin/zenoh-bridge-dds -c /etc/zenoh-bridge-dds/conf.json5
Restart=on-failure

[Install]
WantedBy=multi-user.target
