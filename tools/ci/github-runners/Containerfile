FROM docker.io/nixos/nix:2.34.8 AS nix

FROM docker.io/debian:trixie-slim

RUN apt-get update && apt-get install --no-install-recommends --yes \
    ca-certificates \
    clang \
    cmake \
    curl \
    git \
    git-lfs \
    libasound2-dev \
    libdbus-1-dev \
    libhdf5-dev \
    libluajit-5.1-dev \
    libopusfile-dev \
    libpython3.13 \
    libsystemd-dev \
    libudev-dev \
    lua-inspect \
    ninja-build \
    python3 \
    python3-click \
    python3-git \
    rsync \
    unzip \
    zstd \
    && rm --recursive --force /var/lib/apt/lists/*

RUN useradd -m -u 1000 hulk

COPY --from=nix --chown=1000:1000 /nix/ /nix/
# CI runs Nix as UID 1000 in an unprivileged job container, without a daemon.
RUN chown 1000:1000 /nix && \
    mkdir -p /etc/nix && \
    printf 'experimental-features = nix-command flakes\nbuild-users-group =\nsandbox = false\n' > /etc/nix/nix.conf && \
    ln -s /nix/var/nix/profiles/default/bin/nix /usr/local/bin/nix
